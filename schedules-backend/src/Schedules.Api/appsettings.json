{
  "ConnectionStrings": {
    "SchedulesDb": "Host=${RDS_HOST};Port=5432;Database=itcenter_auth;Username=${RDS_USER};Password=${RDS_PASSWORD};Maximum Pool Size=50;Timeout=15"
  },
  "_comment": "RDS connection string uses environment variables. For local development, use appsettings.Development.json",
  "Persistence": {
    "UseInMemory": false
  },
  "AwsSecrets": {
    "SecretName": "itcenter/rds"
  },
  "FeatureFlags": {
    "enable_ms_graph_sync": true,
    "enable_task_notifications": true,
    "enable_bulk_import": true
  },
  "Graph": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "Scopes": [ "https://graph.microsoft.com/.default" ],
    "NotificationWebhook": ""
  },
  "Jobs": {
    "ReminderSchedule": "0 8 * * *",
    "CsvBucket": "itcenter-phase4-imports"
  },
  "Telemetry": {
    "OtlpEndpoint": "http://localhost:4318"
  },
  "Authentication": {
    "Authority": "https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_hTAYJId8y",
    "Audience": "itcenter-api"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
