# Laravel .gitignore

# Dependencies
/vendor/
/node_modules/

# Environment files
.env
.env.backup
.env.production
.env.*.local

# Laravel specific
/storage/*.key
/storage/logs/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore
/bootstrap/cache/*
!bootstrap/cache/.gitignore

# Compiled assets
/public/hot
/public/storage
/public/build
/public/mix-manifest.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
/coverage/
.phpunit.result.cache
/.phpunit.cache

# Temporary files
*.tmp
*.temp
*.cache

# Composer
composer.phar
# Note: composer.lock should be committed in Laravel projects

# Public directory (if it contains generated files)
/public/index.php.bak

# Laravel specific cache
/.phpstorm.meta.php
/_ide_helper.php
/_ide_helper_models.php
/.fleet
/.nova

