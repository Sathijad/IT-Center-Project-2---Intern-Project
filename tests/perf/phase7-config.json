{
  "test_configs": {
    "smoke": {
      "description": "Smoke test - minimal load to verify system works",
      "script": "phase7-smoke.js",
      "vus": 1,
      "duration": "30s",
      "thresholds": {
        "http_req_duration": ["p(95)<1000"],
        "http_req_failed": ["rate<0.01"]
      }
    },
    "load": {
      "description": "Load test - normal expected load",
      "script": "phase7-load.js",
      "stages": [
        { "duration": "1m", "target": 20 },
        { "duration": "3m", "target": 50 },
        { "duration": "1m", "target": 0 }
      ],
      "thresholds": {
        "http_req_duration": ["p(95)<500", "p(99)<1000"],
        "http_req_failed": ["rate<0.01"]
      }
    },
    "stress": {
      "description": "Stress test - push system to limits",
      "script": "phase7-stress.js",
      "stages": [
        { "duration": "1m", "target": 50 },
        { "duration": "2m", "target": 100 },
        { "duration": "2m", "target": 200 },
        { "duration": "2m", "target": 300 },
        { "duration": "2m", "target": 200 },
        { "duration": "1m", "target": 0 }
      ],
      "thresholds": {
        "http_req_duration": ["p(95)<2000"],
        "http_req_failed": ["rate<0.05"]
      }
    },
    "full": {
      "description": "Full performance test - comprehensive scenarios",
      "script": "phase7-feedback.js",
      "stages": [
        { "duration": "30s", "target": 10 },
        { "duration": "1m", "target": 50 },
        { "duration": "30s", "target": 100 },
        { "duration": "2m", "target": 100 },
        { "duration": "30s", "target": 0 }
      ],
      "thresholds": {
        "http_req_duration": ["p(95)<500", "p(99)<1000"],
        "http_req_failed": ["rate<0.02"]
      }
    }
  },
  "endpoints": {
    "public": [
      "GET /api/v1/healthz"
    ],
    "authenticated": [
      "POST /api/v1/feedback",
      "GET /api/v1/feedback",
      "GET /api/v1/feedback/{id}",
      "POST /api/v1/feedback/{id}/messages"
    ],
    "admin_only": [
      "PATCH /api/v1/feedback/{id}",
      "POST /api/v1/feedback/{id}/analyze",
      "GET /api/v1/exports/feedback.csv",
      "POST /api/v1/integrations/teams/notify"
    ]
  },
  "environment_variables": {
    "API_BASE_URL": "Base URL of the feedback API (default: http://localhost:8086)",
    "EMPLOYEE_TOKEN": "JWT token for employee user",
    "ADMIN_TOKEN": "JWT token for admin user"
  }
}

