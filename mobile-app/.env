# Mobile Platform Configuration
# Options: Android, iOS
MOBILE_PLATFORM=Android

# Device Configuration
# For emulator: Use the AVD name (e.g., Pixel_7_API_34)
# For real device: Use device name from `adb devices`
MOBILE_DEVICE_NAME=Pixel_5

# Platform Version
# Android API level (e.g., 14, 15, 33, 34)
# Based on AVD target: android-33
MOBILE_PLATFORM_VERSION=13

# App Path
# Path to the debug APK file
# Use absolute path or relative path from mobile-app directory
MOBILE_APP_PATH=./build/app/outputs/flutter-apk/app-debug.apk

# Optional: Device UDID
# Only needed for real devices when multiple devices are connected
# Leave empty for emulator or single device
# MOBILE_UDID=

# Authentication Credentials
# Used for login tests (MFA code entry is manual)
MOBILE_EMAIL=admin@test.com
MOBILE_PASSWORD=Admin@123

# Example with absolute path:
# MOBILE_APP_PATH=C:\Users\SathijaDeshapriya\Downloads\IT Center Project 2\mobile-app\build\app\outputs\flutter-apk\app-debug.apk

