{
  "name": "appium-flutter-test",
  "version": "1.0.0",
  "description": "Appium tests for Flutter mobile app - Phase 1 Staff Authentication & Role Management, Phase 2 Staff Leave & Attendance Management, Phase 3 Staff Room & Resource Booking, Phase 4 Schedule & Tasks, Phase 5 Events & Announcements, Phase 6 KPI Dashboard & Training",
  "main": "wdio.conf.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:phase1": "wdio run wdio.conf.js --spec test/specs/phase1*.spec.js",
    "test:auth-role-flow": "wdio run wdio.conf.js --spec test/specs/phase1_complete_auth_role_flow.spec.js",
    "test:phase2": "wdio run wdio.conf.js --spec test/specs/phase2*.spec.js",
    "test:leave-attendance-flow": "wdio run wdio.conf.js --spec test/specs/phase2_complete_leave_attendance_flow.spec.js",
    "test:phase3": "wdio run wdio.conf.js --spec test/specs/phase3*.spec.js",
    "test:booking-flow": "wdio run wdio.conf.js --spec test/specs/phase3_complete_booking_flow.spec.js",
    "test:phase4": "wdio run wdio.conf.js --spec test/specs/phase4*.spec.js",
    "test:schedule-overview": "wdio run wdio.conf.js --spec test/specs/phase4_schedule_overview.spec.js",
    "test:schedule-flow": "wdio run wdio.conf.js --spec test/specs/phase4_complete_schedule_flow.spec.js",
    "test:phase5": "wdio run wdio.conf.js --spec test/specs/phase5*.spec.js",
    "test:announcements": "wdio run wdio.conf.js --spec test/specs/phase5_announcements_overview.spec.js",
    "test:phase6": "wdio run wdio.conf.js --spec test/specs/phase6*.spec.js",
    "test:kpi-dashboard": "wdio run wdio.conf.js --spec test/specs/phase6_kpi_dashboard.spec.js",
    "test:performance-flow": "wdio run wdio.conf.js --spec test/specs/phase6_complete_performance_flow.spec.js"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "flutter",
    "mobile",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "webdriverio": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^2.0.0",
    "@wdio/appium-service": "^9.0.0",
    "appium-uiautomator2-driver": "^2.0.0"
  },
  "devDependencies": {}
}

