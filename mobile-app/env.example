# Device name reported by `adb devices`
ANDROID_DEVICE_NAME=emulator-5554

# Android version number (NOT API level)
# Example: 13 for Android 13 (API 33)
ANDROID_PLATFORM_VERSION=13

# Path to the debug APK (absolute recommended)
ANDROID_APP_PATH=./build/app/outputs/flutter-apk/app-debug.apk

# Keep the app installed between runs (true/false)
ANDROID_NO_RESET=false

